{
  "name": "@sqve/stomme-ts-imports",
  "version": "0.2.1",
  "private": true,
  "description": "Oxlint import rules for the module table in stomme.toml.",
  "keywords": [
    "imports",
    "lint",
    "modules",
    "oxlint",
    "typescript"
  ],
  "homepage": "https://github.com/sQVe/stomme/tree/main/packages/imports#readme",
  "bugs": "https://github.com/sQVe/stomme/issues",
  "license": "MIT",
  "author": "Oskar Grunning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sQVe/stomme.git",
    "directory": "packages/imports"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm style:check && pnpm format:check && pnpm build && pnpm test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "prepare": "vp config --no-hooks",
    "style:check": "node ../style/src/cli.ts",
    "style:fix": "node ../style/src/cli.ts --fix",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@oxlint/plugins": "1.79.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.3.4"
}
