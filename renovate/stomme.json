{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stomme\\.toml$/"],
      "matchStrings": [
        "^(?:[^\\[\\n]*\\n)*?[ \\t]*version[ \\t]*=[ \\t]*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "sQVe/stomme",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Pins the reusable sync workflow by commit with a `# vX.Y.Z` comment. The second match string converts an old tag call, and the template always writes the SHA form. Only the unquoted `uses:` form is rewritten; quoted calls are left alone.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "uses:[ \\t]+sQVe/stomme/\\.github/workflows/sync-update\\.yml@(?<currentDigest>[0-9a-f]{40})[ \\t]+#[ \\t]*(?<currentValue>v[0-9][^\\s\"']*)[ \\t]*\\n",
        "uses:[ \\t]+sQVe/stomme/\\.github/workflows/sync-update\\.yml@(?<currentValue>v[0-9][^\\s\"']*)[ \\t]*\\n"
      ],
      "depNameTemplate": "sQVe/stomme",
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "uses: sQVe/stomme/.github/workflows/sync-update.yml@{{newDigest}} # {{newValue}}\n"
    },
    {
      "customType": "regex",
      "description": "Pins the reusable OCR workflow by commit with a `# vX.Y.Z` comment. The second match string converts an old tag call, and the template always writes the SHA form. Only the unquoted `uses:` form is rewritten; quoted calls are left alone.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "uses:[ \\t]+sQVe/stomme/\\.github/workflows/ocr-review\\.yml@(?<currentDigest>[0-9a-f]{40})[ \\t]+#[ \\t]*(?<currentValue>v[0-9][^\\s\"']*)[ \\t]*\\n",
        "uses:[ \\t]+sQVe/stomme/\\.github/workflows/ocr-review\\.yml@(?<currentValue>v[0-9][^\\s\"']*)[ \\t]*\\n"
      ],
      "depNameTemplate": "sQVe/stomme",
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "uses: sQVe/stomme/.github/workflows/ocr-review.yml@{{newDigest}} # {{newValue}}\n"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["sQVe/stomme"],
      "enabled": false
    },
    {
      "description": "Adds a commit digest to a reusable sync or OCR workflow called by tag. `stomme.toml` pins a version, not a workflow call, so this rule covers workflow files only.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "matchPackageNames": ["sQVe/stomme"],
      "pinDigests": true
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["github:sQVe/stomme"],
      "matchPackageNames": ["sQVe/stomme"],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "matchPackageNames": ["sQVe/stomme"],
      "groupName": "stomme",
      "groupSlug": "stomme",
      "groupSingleUpdates": true,
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "@sqve/stomme-ts-style",
        "@sqve/stomme-ts-imports",
        "@sqve/mutation"
      ],
      "enabled": false
    }
  ]
}
